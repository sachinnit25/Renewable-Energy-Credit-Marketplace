{
  "name": "rec-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "serve": "vite",
    "test": "node --test test/*.test.js",
    "test:contracts": "cd contracts/soroban_rec && cargo test --lib --verbose",
    "test:all": "npm test && npm run test:contracts",
    "ci": "npm test && npm run test:contracts && cargo build --manifest-path contracts/soroban_rec/Cargo.toml --target wasm32-unknown-unknown --release && npm run build",
    "deploy:contract": "node scripts/deploy_soroban.mjs",
    "interact:contract": "node scripts/interact_contract.mjs",
    "seed:recs": "node scripts/seed_marketplace_recs.mjs",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "playwright": "^1.62.0",
    "vite": "^6.0.0"
  }
}
